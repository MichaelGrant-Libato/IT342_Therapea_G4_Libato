<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="18dp"
    android:background="?attr/selectableItemBackground"
    android:paddingVertical="10dp">

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp">

        <TextView
            android:id="@+id/tvConvAvatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_circle_green"
            android:gravity="center"
            android:textColor="#0A5C36"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="visible" />

        <ImageView
            android:id="@+id/ivConvAvatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_circle_green"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:visibility="gone" />

        <View
            android:id="@+id/viewUnreadDot"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_unread_dot"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvConvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#1C1F1A"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvConvLastMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#7A8077"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvConvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#94A3B8"
            android:textSize="11sp" />

        <View
            android:id="@+id/viewUnreadBadge"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginTop="6dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_unread_dot"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>