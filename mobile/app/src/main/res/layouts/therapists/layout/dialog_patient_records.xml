<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#F1F5F0"
    android:layout_width="match_parent"
    android:layout_height="500dp"> <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:padding="20dp"
    android:elevation="2dp"
    android:orientation="vertical">

    <TextView
        android:text="CLINICAL RECORDS"
        android:textSize="10sp"
        android:letterSpacing="0.1"
        android:textStyle="bold"
        android:textColor="#7A8077"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/txtPatientTitle"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:textSize="22sp"
        android:textColor="#1C1F1A"
        android:layout_marginTop="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ProgressBar
            android:id="@+id/progressRecords"
            android:layout_gravity="center"
            android:indeterminateTint="#0A5C36"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/txtNoRecords"
            android:text="No clinical records found."
            android:textColor="#7A8077"
            android:visibility="gone"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerRecords"
            android:clipToPadding="false"
            android:paddingTop="16dp"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>