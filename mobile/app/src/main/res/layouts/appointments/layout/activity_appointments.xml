<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F2"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <TextView
            android:id="@+id/tvAppointmentsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:text="Your Appointments"
            android:textColor="#1C1F1A"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnBookSession"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/admin_bg_button_primary"
            android:paddingHorizontal="18dp"
            android:text="+ Book"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvAppointmentsSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:paddingHorizontal="20dp"
        android:paddingBottom="14dp"
        android:text="View and manage your therapy sessions."
        android:textColor="#7A8077"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8EDE8" />

    <!-- Tabs -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <Button
                android:id="@+id/btnUpcoming"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/admin_bg_button_primary"
                android:paddingHorizontal="20dp"
                android:text="Upcoming"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPast"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/admin_bg_button_outline"
                android:paddingHorizontal="20dp"
                android:text="Past Sessions"
                android:textAllCaps="false"
                android:textColor="#1C1F1A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCalendar"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/admin_bg_button_outline"
                android:paddingHorizontal="20dp"
                android:text="Calendar"
                android:textAllCaps="false"
                android:textColor="#1C1F1A"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8EDE8" />

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvAppointmentsMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="40dp"
                android:textColor="#7A8077"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/appointmentsListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Calendar -->
            <LinearLayout
                android:id="@+id/calendarContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPrevMonth"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/admin_bg_button_outline"
                        android:text="‹"
                        android:textAllCaps="false"
                        android:textColor="#1C1F1A"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tvCalendarMonth"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="#1C1F1A"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnNextMonth"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/admin_bg_button_outline"
                        android:text="›"
                        android:textAllCaps="false"
                        android:textColor="#1C1F1A"
                        android:textSize="20sp" />
                </LinearLayout>

                <android.widget.GridLayout
                    android:id="@+id/calendarGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:columnCount="7" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/selectedDayContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>