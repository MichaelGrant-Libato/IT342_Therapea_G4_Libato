<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/assessmentResultScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/assessmentResultRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <Button
            android:id="@+id/btnResultBack"
            android:layout_width="110dp"
            android:layout_height="46dp"
            android:background="@drawable/admin_bg_button_outline"
            android:text="Back"
            android:textAllCaps="false"
            android:textColor="#1E293B"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/resultMainCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/admin_bg_card"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:id="@+id/tvResultTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="Assessment Record"
                android:textColor="#1E293B"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvResultDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="#64748B"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/riskBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="#F8FAFC"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Recorded risk level"
                    android:textColor="#64748B"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRiskLevel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Low"
                    android:textColor="#0A5C36"
                    android:textSize="36sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvClinicalScore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="Clinical score: 0 out of 100"
                android:textColor="#1E293B"
                android:textSize="19sp"
                android:textStyle="bold" />

            <android.widget.GridLayout
                android:id="@+id/resultScoresGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:columnCount="2"
                android:useDefaultMargins="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="118dp"
                    android:layout_columnWeight="1"
                    android:background="#F8FAFC"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PHQ-9 Depression"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPhqScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#1E293B"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPhqLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/ 27"
                        android:textColor="#64748B"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="118dp"
                    android:layout_columnWeight="1"
                    android:background="#F8FAFC"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GAD-7 Anxiety"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGadScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#1E293B"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGadLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/ 21"
                        android:textColor="#64748B"
                        android:textSize="12sp" />
                </LinearLayout>
            </android.widget.GridLayout>

            <TextView
                android:id="@+id/tvRecordStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/admin_bg_pill_green"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="Pending"
                android:textColor="#0A5C36"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvActionMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textColor="#64748B"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/resultActionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>