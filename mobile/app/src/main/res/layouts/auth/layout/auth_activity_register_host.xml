<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F2"
    android:orientation="vertical">

    <ViewFlipper
        android:id="@+id/regFlipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ============================================== -->
        <!-- 0: PERSONAL INFO                               -->
        <!-- ============================================== -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Join TheraPea" android:fontFamily="sans-serif-black" android:textColor="#1C1F1A" android:textSize="28sp" android:letterSpacing="-0.02" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Create your account to get started" android:fontFamily="sans-serif-medium" android:textColor="#7A8077" android:textSize="15sp" />

                <!-- Rounded Pill Progress Bar -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="horizontal">
                    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" app:cardBackgroundColor="#7A9E78" app:cardElevation="0dp" app:cardCornerRadius="4dp" android:layout_marginEnd="8dp"/>
                    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" app:cardBackgroundColor="#ECEEE8" app:cardElevation="0dp" app:cardCornerRadius="4dp" android:layout_marginEnd="8dp"/>
                    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" app:cardBackgroundColor="#ECEEE8" app:cardElevation="0dp" app:cardCornerRadius="4dp" />
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="28dp" android:text="STEP 1 OF 3 — PERSONAL INFO" android:fontFamily="sans-serif-medium" android:letterSpacing="0.05" android:textColor="#7A8077" android:textSize="11sp" />

                <TextView android:id="@+id/tvRegError1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:background="@drawable/bg_input" android:backgroundTint="#FEF2F2" android:padding="16dp" android:fontFamily="sans-serif-medium" android:textColor="#991B1B" android:visibility="gone" />

                <EditText android:id="@+id/etRegName" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginBottom="16dp" android:background="@drawable/bg_input" android:hint="Full Name" android:paddingHorizontal="16dp" android:textColor="#1C1F1A" android:textColorHint="#9CA3AF" android:textSize="15sp" />
                <EditText android:id="@+id/etRegEmail" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginBottom="16dp" android:background="@drawable/bg_input" android:hint="Email Address" android:inputType="textEmailAddress" android:paddingHorizontal="16dp" android:textColor="#1C1F1A" android:textColorHint="#9CA3AF" android:textSize="15sp" />
                <EditText android:id="@+id/etRegPass" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginBottom="16dp" android:background="@drawable/bg_input" android:hint="Password" android:inputType="textPassword" android:paddingHorizontal="16dp" android:textColor="#1C1F1A" android:textColorHint="#9CA3AF" android:textSize="15sp" />
                <EditText android:id="@+id/etRegConfirm" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginBottom="32dp" android:background="@drawable/bg_input" android:hint="Confirm Password" android:inputType="textPassword" android:paddingHorizontal="16dp" android:textColor="#1C1F1A" android:textColorHint="#9CA3AF" android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton android:id="@+id/btnNext1" android:layout_width="match_parent" android:layout_height="60dp" android:backgroundTint="#7A9E78" android:text="Continue" android:textAllCaps="false" android:textSize="16sp" android:fontFamily="sans-serif-medium" app:cornerRadius="14dp" app:elevation="2dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="20dp" android:layout_marginBottom="20dp">
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#D1D5DB" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Or continue with" android:textColor="#9CA3AF" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:layout_marginHorizontal="16dp" />
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#D1D5DB" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton android:id="@+id/btnRegGoogleLogin" android:layout_width="match_parent" android:layout_height="60dp" android:backgroundTint="#FFFFFF" android:text="Google" android:textAllCaps="false" android:textColor="#1C1F1A" android:textSize="16sp" android:fontFamily="sans-serif-medium" app:cornerRadius="14dp" app:strokeColor="#D1D5DB" app:strokeWidth="1dp" app:elevation="0dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:gravity="center" android:paddingBottom="24dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Already have an account? " android:textColor="#7A8077" android:textSize="15sp" />
                    <TextView android:id="@+id/btnGoToLogin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sign In" android:textColor="#7A9E78" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ============================================== -->
        <!-- 1: OTP VERIFICATION (GOOGLE)                   -->
        <!-- ============================================== -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal">

                <com.google.android.material.card.MaterialCardView android:layout_width="80dp" android:layout_height="80dp" android:layout_marginTop="40dp" android:layout_marginBottom="24dp" app:cardBackgroundColor="#EAF0EA" app:cardCornerRadius="40dp" app:cardElevation="0dp">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_dialog_email" app:tint="#7A9E78" android:layout_gravity="center" />
                </com.google.android.material.card.MaterialCardView>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Check your inbox" android:fontFamily="sans-serif-black" android:textColor="#1C1F1A" android:textSize="26sp" />
                <TextView android:id="@+id/tvOtpSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#7A8077" android:textSize="15sp" android:lineSpacingExtra="4dp" android:gravity="center" android:layout_marginBottom="40dp"/>

                <EditText android:id="@+id/etOtpCode" android:layout_width="220dp" android:layout_height="64dp" android:layout_marginBottom="32dp" android:background="@drawable/bg_input" android:hint="0 0 0 0 0 0" android:inputType="number" android:maxLength="6" android:gravity="center" android:letterSpacing="0.8" android:textColor="#1C1F1A" android:textColorHint="#D1D5DB" android:textSize="28sp" android:fontFamily="sans-serif-medium" />

                <com.google.android.material.button.MaterialButton android:id="@+id/btnVerifyOtp" android:layout_width="match_parent" android:layout_height="60dp" android:backgroundTint="#7A9E78" android:text="Verify &amp; Continue" android:textAllCaps="false" android:textSize="16sp" android:fontFamily="sans-serif-medium" app:cornerRadius="14dp" app:elevation="2dp"/>
                <TextView android:id="@+id/btnResendOtp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:text="Didn't receive it? Resend code" android:textColor="#7A8077" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </ScrollView>

        <!-- ============================================== -->
        <!-- 2: ROLE SELECTION                              -->
        <!-- ============================================== -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">

                <TextView android:id="@+id/tvRoleHeader" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Who are you?" android:fontFamily="sans-serif-black" android:textColor="#1C1F1A" android:textSize="28sp" android:letterSpacing="-0.02"/>
                <TextView android:id="@+id/tvRoleSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="This helps us set up the right experience." android:fontFamily="sans-serif-medium" android:textColor="#7A8077" android:textSize="15sp" />

                <!-- Rounded Pill Progress Bar -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="horizontal">
                    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" app:cardBackgroundColor="#7A9E78" app:cardElevation="0dp" app:cardCornerRadius="4dp" android:layout_marginEnd="8dp"/>
                    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" app:cardBackgroundColor="#7A9E78" app:cardElevation="0dp" app:cardCornerRadius="4dp" android:layout_marginEnd="8dp"/>
                    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" app:cardBackgroundColor="#ECEEE8" app:cardElevation="0dp" app:cardCornerRadius="4dp" />
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="24dp" android:text="STEP 2 OF 3 — ACCOUNT SETUP" android:fontFamily="sans-serif-medium" android:letterSpacing="0.05" android:textColor="#7A8077" android:textSize="11sp" />

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardPatient" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="#EAF0EA" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="#7A9E78" app:strokeWidth="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="24dp" android:gravity="center_vertical">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/ic_menu_myplaces" app:tint="#7A9E78" android:layout_marginEnd="16dp"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="I am a Patient" android:textColor="#1C1F1A" android:textSize="18sp" android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardDoctor" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="40dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="#D1D5DB" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="24dp" android:gravity="center_vertical">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/ic_menu_add" app:tint="#9CA3AF" android:layout_marginEnd="16dp"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="I am a Licensed Doctor" android:textColor="#1C1F1A" android:textSize="18sp" android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton android:id="@+id/btnNext2" android:layout_width="match_parent" android:layout_height="60dp" android:backgroundTint="#7A9E78" android:text="Next Step" android:textAllCaps="false" android:textSize="16sp" android:fontFamily="sans-serif-medium" app:cornerRadius="14dp" app:elevation="2dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnBackToStep1" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="12dp" android:backgroundTint="#00000000" android:text="Go Back" android:textAllCaps="false" android:textColor="#7A8077" android:textSize="15sp" android:fontFamily="sans-serif-medium" app:cornerRadius="14dp" app:strokeWidth="0dp" app:elevation="0dp" />
            </LinearLayout>
        </ScrollView>

        <!-- ============================================== -->
        <!-- 3: REVIEW & CONFIRM                            -->
        <!-- ============================================== -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Review &amp; Confirm" android:fontFamily="sans-serif-black" android:textColor="#1C1F1A" android:textSize="28sp" android:letterSpacing="-0.02"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Take a look before we finalize your setup." android:fontFamily="sans-serif-medium" android:textColor="#7A8077" android:textSize="15sp" />

                <!-- Rounded Pill Progress Bar -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="horizontal">
                    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" app:cardBackgroundColor="#7A9E78" app:cardElevation="0dp" app:cardCornerRadius="4dp" android:layout_marginEnd="8dp"/>
                    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" app:cardBackgroundColor="#7A9E78" app:cardElevation="0dp" app:cardCornerRadius="4dp" android:layout_marginEnd="8dp"/>
                    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" app:cardBackgroundColor="#7A9E78" app:cardElevation="0dp" app:cardCornerRadius="4dp" />
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="16dp" android:text="STEP 3 OF 3 — REVIEW" android:fontFamily="sans-serif-medium" android:letterSpacing="0.05" android:textColor="#7A8077" android:textSize="11sp" />

                <TextView android:id="@+id/tvRegError3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:background="@drawable/bg_input" android:backgroundTint="#FEF2F2" android:padding="16dp" android:fontFamily="sans-serif-medium" android:textColor="#991B1B" android:visibility="gone" />

                <TextView android:id="@+id/tvDoctorNotice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp" android:background="@drawable/bg_input" android:backgroundTint="#FFFBEB" android:padding="16dp" android:text="Next, you will be asked to upload your PRC license and fill in your clinical profile." android:fontFamily="sans-serif-medium" android:textColor="#92400E" android:textSize="13sp" android:lineSpacingExtra="2dp" android:visibility="gone"/>

                <!-- Premium Review Card -->
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="32dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="#E5E7EB" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Account Details" android:textColor="#1C1F1A" android:fontFamily="sans-serif-black" android:textSize="18sp" android:layout_marginBottom="20dp"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FULL NAME" android:textColor="#9CA3AF" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.05" />
                        <TextView android:id="@+id/tvReviewName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#1C1F1A" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:layout_marginTop="2dp" android:layout_marginBottom="16dp"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EMAIL ADDRESS" android:textColor="#9CA3AF" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.05" />
                        <TextView android:id="@+id/tvReviewEmail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#1C1F1A" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:layout_marginTop="2dp" android:layout_marginBottom="16dp"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ACCOUNT TYPE" android:textColor="#9CA3AF" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.05" />
                        <TextView android:id="@+id/tvReviewRole" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#7A9E78" android:textSize="16sp" android:fontFamily="sans-serif-black" android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <CheckBox android:id="@+id/cbTerms" android:layout_width="match_parent" android:layout_height="wrap_content" android:buttonTint="#7A9E78" android:text="I agree to the Terms of Service and Privacy Policy" android:textColor="#4A5047" android:fontFamily="sans-serif-medium" android:textSize="14sp" />
                <CheckBox android:id="@+id/cbConsent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:buttonTint="#7A9E78" android:text="I agree to receive communications about my care" android:textColor="#4A5047" android:fontFamily="sans-serif-medium" android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton android:id="@+id/btnSubmitFinal" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="36dp" android:backgroundTint="#1C1F1A" android:text="Create Account" android:textAllCaps="false" android:textSize="16sp" android:fontFamily="sans-serif-medium" app:cornerRadius="14dp" app:elevation="2dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnBackToStep2" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="12dp" android:backgroundTint="#00000000" android:text="Go Back" android:textAllCaps="false" android:textColor="#7A8077" android:textSize="15sp" android:fontFamily="sans-serif-medium" app:cornerRadius="14dp" app:strokeWidth="0dp" app:elevation="0dp" />
            </LinearLayout>
        </ScrollView>

        <!-- ============================================== -->
        <!-- 4: DOCTOR BIO                                  -->
        <!-- ============================================== -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">

                <TextView android:id="@+id/tvDoctorWelcome" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#1C1F1A" android:fontFamily="sans-serif-black" android:textSize="28sp" android:letterSpacing="-0.02"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Let patients know about your expertise." android:fontFamily="sans-serif-medium" android:textColor="#7A8077" android:textSize="15sp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="horizontal">
                    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" app:cardBackgroundColor="#7A9E78" app:cardElevation="0dp" app:cardCornerRadius="4dp" android:layout_marginEnd="8dp"/>
                    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" app:cardBackgroundColor="#ECEEE8" app:cardElevation="0dp" app:cardCornerRadius="4dp" />
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="24dp" android:text="STEP 1 OF 2 — PROFESSIONAL PROFILE" android:fontFamily="sans-serif-medium" android:letterSpacing="0.05" android:textColor="#7A8077" android:textSize="11sp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Clinical Biography *" android:textColor="#4A5047" android:textSize="13sp" android:fontFamily="sans-serif-black" android:layout_marginBottom="8dp"/>
                <EditText android:id="@+id/etDocBio" android:layout_width="match_parent" android:layout_height="160dp" android:layout_marginBottom="24dp" android:background="@drawable/bg_input" android:gravity="top|start" android:hint="Describe your medical background, specialization, and experience..." android:inputType="textMultiLine" android:padding="16dp" android:textColor="#1C1F1A" android:textColorHint="#9CA3AF" android:textSize="15sp" android:lineSpacingExtra="4dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hourly Rate (PHP) *" android:textColor="#4A5047" android:textSize="13sp" android:fontFamily="sans-serif-black" android:layout_marginBottom="8dp"/>
                <EditText android:id="@+id/etDocRate" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginBottom="40dp" android:background="@drawable/bg_input" android:hint="e.g. 1500.00" android:inputType="numberDecimal" android:paddingHorizontal="16dp" android:textColor="#1C1F1A" android:textColorHint="#9CA3AF" android:textSize="16sp" />

                <com.google.android.material.button.MaterialButton android:id="@+id/btnDocNext1" android:layout_width="match_parent" android:layout_height="60dp" android:backgroundTint="#1C1F1A" android:text="Next Step" android:textAllCaps="false" android:textSize="16sp" android:fontFamily="sans-serif-medium" app:cornerRadius="14dp" app:elevation="2dp" />
            </LinearLayout>
        </ScrollView>

        <!-- ============================================== -->
        <!-- 5: DOCTOR LICENSE                              -->
        <!-- ============================================== -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Verify your license" android:fontFamily="sans-serif-black" android:textColor="#1C1F1A" android:textSize="28sp" android:letterSpacing="-0.02"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Upload a clear document to confirm your credentials." android:fontFamily="sans-serif-medium" android:textColor="#7A8077" android:textSize="15sp" android:lineSpacingExtra="2dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="horizontal">
                    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" app:cardBackgroundColor="#7A9E78" app:cardElevation="0dp" app:cardCornerRadius="4dp" android:layout_marginEnd="8dp"/>
                    <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" app:cardBackgroundColor="#7A9E78" app:cardElevation="0dp" app:cardCornerRadius="4dp" />
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="32dp" android:text="STEP 2 OF 2 — LICENSE VERIFICATION" android:fontFamily="sans-serif-medium" android:letterSpacing="0.05" android:textColor="#7A8077" android:textSize="11sp" />

                <LinearLayout android:id="@+id/btnPickFile" android:layout_width="match_parent" android:layout_height="240dp" android:layout_marginBottom="32dp" android:background="@drawable/bg_dashed_upload" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_upload" app:tint="#9CA3AF" android:layout_marginBottom="12dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tap to browse files" android:textColor="#1C1F1A" android:fontFamily="sans-serif-black" android:textSize="16sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="PNG, JPG, PDF (Max 10MB)" android:textColor="#9CA3AF" android:fontFamily="sans-serif-medium" android:textSize="13sp" />
                    <TextView android:id="@+id/tvSelectedFile" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textColor="#7A9E78" android:fontFamily="sans-serif-black" android:textSize="15sp" android:visibility="gone" android:gravity="center" android:paddingHorizontal="24dp"/>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton android:id="@+id/btnSubmitDoctor" android:layout_width="match_parent" android:layout_height="60dp" android:backgroundTint="#1C1F1A" android:text="Submit Application" android:textAllCaps="false" android:textSize="16sp" android:fontFamily="sans-serif-medium" app:cornerRadius="14dp" app:elevation="2dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnDocBackToBio" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="12dp" android:backgroundTint="#00000000" android:text="Go Back" android:textAllCaps="false" android:textColor="#7A8077" android:textSize="15sp" android:fontFamily="sans-serif-medium" app:cornerRadius="14dp" app:strokeWidth="0dp" app:elevation="0dp" />
            </LinearLayout>
        </ScrollView>

        <!-- ============================================== -->
        <!-- 6: DOCTOR SUCCESS                              -->
        <!-- ============================================== -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="32dp">

            <com.google.android.material.card.MaterialCardView android:layout_width="80dp" android:layout_height="80dp" android:layout_marginBottom="24dp" app:cardBackgroundColor="#EAF0EA" app:cardCornerRadius="40dp" app:cardElevation="0dp">
                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@android:drawable/ic_dialog_info" app:tint="#7A9E78" android:layout_gravity="center" />
            </com.google.android.material.card.MaterialCardView>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="Application Submitted!" android:textColor="#1C1F1A" android:fontFamily="sans-serif-black" android:textSize="26sp" android:letterSpacing="-0.02" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="32dp" android:gravity="center" android:text="Your application is under review. Please save your reference number to track its status." android:textColor="#7A8077" android:fontFamily="sans-serif-medium" android:textSize="15sp" android:lineSpacingExtra="4dp" />

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="40dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="#E5E7EB" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="24dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="REFERENCE NUMBER" android:textColor="#9CA3AF" android:textSize="11sp" android:fontFamily="sans-serif-black" android:letterSpacing="0.1" />
                    <TextView android:id="@+id/tvRefNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="REF-XXXXXX" android:textColor="#1C1F1A" android:textSize="28sp" android:fontFamily="sans-serif-black" android:letterSpacing="0.05" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton android:id="@+id/btnGoHome" android:layout_width="match_parent" android:layout_height="60dp" android:backgroundTint="#7A9E78" android:text="Return to Login" android:textAllCaps="false" android:textSize="16sp" android:fontFamily="sans-serif-medium" app:cornerRadius="14dp" app:elevation="2dp" />
        </LinearLayout>

    </ViewFlipper>
</LinearLayout>