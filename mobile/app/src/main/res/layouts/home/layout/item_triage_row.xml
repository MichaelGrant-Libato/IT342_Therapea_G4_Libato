<?xml version="1.0" encoding="utf-8"?>
<!-- item_schedule_row.xml
     Inflated dynamically into llScheduleList (Doctor dashboard) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="12dp"
    android:padding="14dp"
    android:background="@drawable/bg_schedule_item">

    <!-- Time column -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:minWidth="90dp"
        android:paddingEnd="14dp"
        android:layout_marginEnd="14dp">

        <!-- Visual right border via a separate View trick is done in code;
             set a right border by wrapping with a FrameLayout if desired -->

        <TextView
            android:id="@+id/tvScheduleDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="May 9"
            android:textColor="@color/text_sub"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/tvScheduleTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="10:00 AM"
            android:textColor="@color/text_main"
            android:textSize="14sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Vertical divider -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="14dp"
        android:minHeight="36dp"
        android:background="@color/bg"/>

    <!-- Patient details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSchedulePatient"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Patient Name"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvScheduleType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Telehealth"
            android:textColor="@color/text_sub"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- Action: Join (Telehealth) or Clinic chip -->
    <TextView
        android:id="@+id/btnJoinCall"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:gravity="center"
        android:paddingHorizontal="14dp"
        android:text="Join"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_btn_primary"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvClinicChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="Clinic"
        android:textColor="@color/text_sub"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/bg_badge_gray"
        android:visibility="gone"/>
</LinearLayout>